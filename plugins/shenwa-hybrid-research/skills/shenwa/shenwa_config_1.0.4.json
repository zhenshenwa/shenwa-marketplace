{
  "name": "shenwa",
  "cn_name": "深挖",
  "version": "1.0.4",
  "description": "Shenwa（深挖） - AI深度调查报告工具",
  "_local_patch": {
    "date": "2026-09-29",
    "scope": "本地修正：移除邀请码依赖",
    "reason": "官方 1.0.4 配置把 login 的 inviteCode 标为 required、并在 auth.user_credentials 中要求输入邀请码，但接口层实际早已不校验（2026-09-27 实测：只传 userID 即返回 success + browserCode）。二者不一致会导致使用者被反复索要邀请码，而新用户并无邀请码可填。",
    "changed": [
      "auth.user_credentials：删除 inviteCode 项",
      "work_flows.login.step1：去掉『手机号和邀请码』表述",
      "api_endpoints[login].request.params[inviteCode].required：true → false，并标注已废弃"
    ],
    "warning": "若官方发布更高版本（GET /api/manage/getLatestVersion 的 latestVersion > 1.0.4）并按新版覆盖本文件、SKILL.md、shenwa_api.py，**必须重新应用本补丁**，否则邀请码问题会复发。"
  },
  "base_url": {
    "primary": "https://www.shenwa.top",
    "fallbacks": ["http://8.130.17.247:8088"],
    "strategy": "primary_fallback"
  },
   "auth": {
     "type": "bearer",
     "obtain_via": "login",
     "session_token_field": "browserCode",
     "session_token_storage": "memory_or_local_file",
     "session_token_ttl_hint": "until 401",
     "user_credentials": [
       { "key": "phone", "prompt": "请输入注册手机号" }
     ],
     "user_credentials_note": "登录只需注册手机号，邀请码已不再需要（2026-09-27 实测：只传 userID 即登录成功）。**切勿向用户索要邀请码**。若手机号提交后仍返回失败，说明该号未开通或权限不足，请联系微信 %wechat% 开号/充值。",
     "user_types": [
       { "name": "VIP", "prompt": "深挖点付费用户" },
       { "name": "VIP2", "prompt": "深挖点付费+接口包时付费用户" }
     ]
   },
  "meta": {
    "support_contact": {"wechat": "shenwa4119"},
    "wechat_public_platform": "真深挖者也",
    "homepage": "https://www.shenwa.top"
  },
  "triggers": {
    "use_when": [
      "用户想对某公司、行业、事件做深度研究/调查",
      "用户想持续跟踪某个行业或个股",
      "用户想阅读全市场报告",
      "用户提到'深挖''调研''调查报告''行业分析''公司研究''财报分析''政策解读'",
      "用户问'最近 XX 股票/公司有什么动态'且需要结构化结论"
    ],
    "do_not_use_when": [
      "用户只是闲聊问'XX 公司是做什么的'这种 1~2 句话能答完的事实问题",
      "用户要求实时行情、当前股价（本 skill 仅在调查报告中引用必要的实时数据，不提供单独的实时数据查询）",
      "用户要做新闻摘要而非深度分析"
    ],
    "keywords": ["shenwa", "深挖", "调查报告", "行业研究", "公司调研", "深度分析", "财报分析", "政策解读"]
  },
  "glossary": {
    "深挖点 (restPoint)": "用户账户的消费额度，每发布一份报告会按模板的 cost 字段扣减",
    "模板 (template)": "预设的报告生成框架，不同模板适用不同场景（公司研究/行业分析/事件复盘等），需先调 templates 接口获取列表让用户挑选",
    "背景消息 (text)": "用户提供的辅助资料，可选，会作为生成报告的上下文",
    "报告状态 (status)": "inprogress=正在生成；public=已发布且公开；private=已发布但仅自己可见；error=已发布但处理出错"
  },
  "agent_guidelines": {
    "before_publish": [
      "调用 report_publish 前，必须先调 user_info 检查 restPoint 是否充足、expireTime 是否过期",
      "若 restPoint 小于模板 cost，提示用户'剩余 X 点不足以发布该模板（需 Y 点），请联系微信 %wechat% 充值'",
      "若用户问题模糊，先反问以聚焦，再生成报告（避免浪费深挖点）"
    ],
    "after_publish": [
      "提交后明确告知用户'报告生成需 3~10 分钟，我会稍后查询'，不要假装实时完成",
      "建议按 async 段的建议轮询，仍未完成则提示用户稍后自行查看"
    ],
    "check_list": [
      "用户想要报告列表时，默认返回公共报告列表，并告知用户这是公共列表，且询问用户是否想要查看私有列表或收藏列表",
      "返回的用户的报告列表，建议采用编号、发布时间、模板名和报告标题字段，每页显示20条"
    ],
    "before_check_detail": [
      "用户提出查看全市场报告或每日报告时，默认返回最新的深挖市场快报",
      "在返回给用户报告详情前，除非用户明确提出或基于用户习惯判断，否则应返回报告原文，勿擅自返回简化的报告"
    ],
    "after_check_detail": [
      "在返回给用户报告详情后，询问用户是否需要下载此报告的PDF"
    ],
    "tone": "假设用户为投研、行业分析师，回答时保持专业、克制，避免口语化",
    "privacy": "不要在对话中回显 browserCode/Token"
  },
  "cost_model": {
    "currency": "深挖点",
    "consumed_by": ["report_publish"],
    "cost_field": "templates[].cost",
    "check_before_call": "user_info.restPoint",
    "exchange_hint": "充值请联系微信 %wechat%"
  },
  "safety": {
    "disallowed_topics": ["政治敏感话题", "暴力非法话题", "基于谣言发布报告"],
    "content_warnings": "报告由 AI 生成，可能包含错误，仅用作参考，重大投资决策前请人工复核"
  },
  "work_flows": {
    "login": {
      "description": "用户登录",
      "steps": {
        "step1": {
          "action": "load_credentials",
          "source": "auth.user_credentials",
          "description": "从本地存储读取注册手机号；若不存在，按 auth.user_credentials 的 prompt 引导用户首次输入并保存。只需手机号，**不要索要邀请码**"
        },
        "step2": {
          "action": "request_api",
          "api_name": "login",
          "description": "执行登录并保存Token(browserCode)"
        }
      }
    },
    "report_manage": {
      "description": "报告查询、管理、发布等流程",
      "steps": {
        "step1": {
          "action": "request_api",
          "api_name": "templates",
          "description": "查看模板列表，了解系统提供了哪些报告模板"
        },
        "step2": {
          "action": "ensure_user_demand",
          "description": "确定用户需求，将用户需要解决的问题转化为：背景消息（可为空）、问题和模板ID。",
          "note": "在无法确定模板时，向用户询问要使用哪个模板，注意询问时不要向用户列出所有模板，仅列出与用户需求高度匹配的模板即可"
        },
        "step3": {
          "action": "request_api",
          "api_name": "report_publish",
          "description": "提交背景消息（可为空）、问题和模板ID发表报告，此发表方式为异步，系统后台会执行此报告，时间在3~10分钟之内",
          "note": "问题在60以内，复杂要求可在背景消息中补充；背景消息（可为空）不多于500字"
        },
        "step4": {
          "action": "request_api",
          "api_name": "report_status",
          "description": "参照report_publish中的async规则向report_status接口发起轮询，检查报告是否成功发布，参数aid为刚发表的报告id，成功后进入step5查看报告详情，若失败则中断流程并向用户报告异常"
        },
        "step5": {
          "action": "request_api",
          "api_name": "report_detail",
          "description": "读取指定的报告，参数aid为新报告的ID"
        },
        "step6": {
          "action": "output_to_user",
          "description": "向用户返回结果，并根据询问用户是否导出pdf，若用户确认，则调用download_pdf接口下载报告PDF"
        }
      }
    },
    "roll_page": {
      "description": "报告列表翻页",
      "steps": {
        "step1": {
          "action": "request_api",
          "api_name": "report_list",
          "description": "设定一个报告数量num，查看报告列表，列表中的报告按时间降序排列",
          "roll_page_pramas": "准备翻页参数，找到列表中的hasNext参数，若为true则表示还有下一页。取出列表所有报告最小的time值作为after参数，进入step2"
        },
        "step2": {
          "action": "request_api",
          "api_name": "report_list",
          "description": "以step1中的num和after参数发起请求，服务器将返回小于after时间的num个报告"
        }
      }
    },
    "update": {
      "description": "Skill升级",
      "requires_user_confirmation": true,
      "steps": {
        "step1": {
          "action": "request_api",
          "api_name": "latest_version",
          "description": "查看最新版本，若最新版本高于当前版本，则进入下一步，否则报告用户“当前已是最新版本”并退出"
        },
        "step2": {
          "action": "request_api",
          "api_name": "download_version",
          "description": "下载指定版本的shenwa_config_<verion>.json文件到~/.openclaw/workspace/skills/shenwa/"
        },
        "step3": {
          "action": "run_install",
          "description": "执行安装过程：备份当前文件和配置，从新版本json文件中提取API列表，更新SKILL.md，在py文件中更新接口读写脚本",
          "note": "旧接口的功能可能有升级，注意覆盖更新所有接口"
        }
      }
    }
  },
  "response_schema": {
    "success_field": "success",
    "status_field": "status",
    "data_field": "data",
    "message_field": "msg"
  },
  "api_endpoints": [
    {
      "name": "login",
      "path": "/api/user/doLogin",
      "description": "执行登录，开启session cookie以让服务器保存会话，下次访可既可通过登录创建会话，也可通过本次登录成功获取的browserCode创建会话",
      "authorization": ["ADM", "VIP", "VIP2"],
      "request": {
        "method": "POST",
        "params": [
          {
            "param": "userID",
            "description": "用户名（注册手机号），联系微信%wechat%，以注册手机号",
            "required": true
          },
          {
            "param": "inviteCode",
            "description": "【已废弃，勿索要】邀请码。自 2026-09-27 实测起接口不再校验，可完全省略；该字段仅为向后兼容保留，传了也不报错。",
            "required": false
          }
        ]
      },
      "responses": {
        "success_schema": {
          "content_type": "application/json",
          "schema_json": {
            "success": true,
            "status": "SUC",
            "data": {
              "browserCode": "Token码，保存此Token，以后可通过此Token直接访问接口"
            },
            "msg": "",
            "time": "服务器时间"
          }
        },
        "error_schema": [
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "AUT",
              "data": null,
              "msg": "手机号错误",
              "time": "服务器时间"
            },
            "description": "手机号未注册，联系微信%wechat%，以注册手机号"
          }
        ]
      }
    },
    {
      "name": "report_list",
      "path": "/api/home/getList",
      "description": "获取报告列表",
      "authorization": ["ADM", "VIP", "VIP2"],
      "request": {
        "method": "GET",
        "headers": [
          {
            "Authorization": "上次登录获取的browserCode（Token），若本次已完成登录并创建session，则可不提供此Token"
          }
        ],
        "params": [
          {
            "param": "type",
            "description": "报告类型，取值：public公开报告，self我的报告，collect我收藏的报告，history我访问过的报告（缺省为public）",
            "required": false
          },
          {
            "param": "num",
            "description": "结果数量（缺省为10）",
            "required": false
          },
          {
            "param": "after",
            "description": "获取某个时间之后的报告，用于翻页。如果上一页的hasNext为true，则将时间最大的报告作为after参数以获取下一页列表",
            "required": false
          }
        ]
      },
      "responses": {
        "success_schema": {
          "content_type": "application/json",
          "schema_json": {
            "success": true,
            "status": "SUC",
            "data": {
              "list": [
                {
                  "aid": "报告ID",
                  "nid": "背景消息ID",
                  "tid": "模板ID",
                  "tTitle": "模板标题",
                  "tImg": "模板图标",
                  "title": "报告标题",
                  "vuser": "用户名",
                  "vpic": "用户头像图片",
                  "vquestion": "我的提问",
                  "stocks": "报告涉及的股票，格式为：股票名,代码,股票在报告中的情感偏向,股票市场，多个股票用分号隔开（如：源杰科技,688498,积极,A;Nvidia,NVDA,中性,美）",
                  "time": "报告发表时间",
                  "status": "报告状态"
                }
              ],
              "hasNext": "是否还有后续报告（用于翻页），取值true/false"
            },
            "msg": "",
            "time": "服务器时间"
          }
        },
        "error_schema": [
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "AUT",
              "data": null,
              "msg": "登录信息已丢失或超时",
              "time": "服务器时间"
            },
            "description": "未登录或Token已过期，须重新执行一次登录更新Token"
          }
        ]
      }
    },
    {
      "name": "report_detail",
      "path": "/api/home/getDetail",
      "description": "获取指定报告",
      "authorization": ["ADM", "VIP", "VIP2"],
      "request": {
        "method": "GET",
        "headers": [
          {
            "Authorization": "上次登录获取的browserCode（Token），若本次已完成登录并创建session，则可不提供此Token"
          }
        ],
        "params": [
          {
            "param": "aid",
            "description": "报告ID",
            "required": true
          }
        ]
      },
      "responses": {
        "success_schema": {
          "content_type": "application/json",
          "schema_json": {
            "success": true,
            "status": "SUC",
            "data": {
              "aid": "报告ID",
              "nid": "背景消息ID",
              "tid": "模板ID",
              "tTitle": "模板标题",
              "tImg": "模板图标",
              "vuser": "用户名",
              "vpic": "用户头像图片",
              "vquestion": "我的提问",
              "stocks": "报告涉及的股票，格式为：股票名,代码,股票在报告中的情感偏向,股票市场，多个股票用分号隔开（如：源杰科技,688498,积极,A;Nvidia,NVDA,中性,美）",
              "detail": "报告详情",
              "time": "报告发表时间",
              "collect": "是否收藏，取值true/false",
              "like": "是否点赞，取值true/false"
            },
            "msg": "",
            "time": "服务器时间"
          }
        },
        "error_schema": [
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "AUT",
              "data": null,
              "msg": "登录信息已丢失或超时",
              "time": "服务器时间"
            },
            "description": "未登录或Token已过期，须重新执行一次登录更新Token"
          },
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "SRV",
              "data": null,
              "msg": "文章不存在",
              "time": "服务器时间"
            },
            "description": "文章ID错误"
          },
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "SRV",
              "data": null,
              "msg": "文章已被删除",
              "time": "服务器时间"
            },
            "description": "文章已被删除"
          },
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "SRV",
              "data": null,
              "msg": "文章已下线",
              "time": "服务器时间"
            },
            "description": "文章已被下架，可能是涉及信息违规"
          }
        ]
      }
    },
    {
      "name": "templates",
      "path": "/api/manage/getTemplateListWithType",
      "description": "以分类视图获取模板列表",
      "authorization": ["ADM", "VIP", "VIP2"],
      "request": {
        "method": "GET",
        "headers": [
          {
            "Authorization": "上次登录获取的browserCode（Token），若本次已完成登录并创建session，则可不提供此Token"
          }
        ],
        "params": []
      },
      "responses": {
        "success_schema": {
          "content_type": "application/json",
          "schema_json": {
            "success": true,
            "status": "SUC",
            "data": [
              {
                "id": "模板分类ID",
                "name": "模板分类名称",
                "describe": "模板分类描述",
                "templates": [
                  {
                    "id": "模板ID",
                    "type": "模板所属分类ID",
                    "title": "模板标题",
                    "describe": "模板特性描述",
                    "image": "模板图标",
                    "cost": "模板消耗（使用此模板的报告花费多少个深挖点）"
                  }
                ]
              }
            ],
            "msg": "",
            "time": "服务器时间"
          }
        },
        "error_schema": [
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "AUT",
              "data": null,
              "msg": "登录信息已丢失或超时",
              "time": "服务器时间"
            },
            "description": "未登录或Token已过期，须重新执行一次登录更新Token"
          }
        ]
      }
    },
    {
      "name": "delete_report",
      "path": "/api/home/deleteArticle",
      "description": "删除用户自己的报告",
      "authorization": ["ADM", "VIP", "VIP2"],
      "request": {
        "method": "GET",
        "headers": [
          {
            "Authorization": "上次登录获取的browserCode（Token），若本次已完成登录并创建session，则可不提供此Token"
          }
        ],
        "params": [
          {
            "param": "aid",
            "description": "报告ID",
            "required": true
          }
        ]
      },
      "responses": {
        "success_schema": {
          "content_type": "application/json",
          "schema_json": {
            "success": true,
            "status": "SUC",
            "data": null,
            "msg": "删除文章成功",
            "time": "服务器时间"
          }
        },
        "error_schema": [
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "AUT",
              "data": null,
              "msg": "登录信息已丢失或超时",
              "time": "服务器时间"
            },
            "description": "未登录或Token已过期，须重新执行一次登录更新Token"
          },
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "SRV",
              "data": null,
              "msg": "ID不存在",
              "time": "服务器时间"
            },
            "description": "报告ID不存在"
          },
          {
            "content_type": "application/json",
            "schema_json": {
              "success": false,
              "status": "SRV",
              "data": null,
              "msg": "无法删除此文章",
              "time": "服务器时间"
            },
            "description": "无删除权限，用户只能删除自己发布的报告"
          }
        ]
      }
    },
    {
      "name": "collect_report",
      "path": "/api/home/doArticleAction",
